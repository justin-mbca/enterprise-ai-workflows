lect * from events_with_attributes", "relation_name": "\"data\".\"main_marts\".\"events_incremental\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-30T06:16:54.922137Z", "completed_at": "2026-10-30T06:16:54.964388Z"}, {"name": "execute", "started_at": "2026-10-30T06:16:54.966666Z", "completed_at": "2026-10-30T06:16:54.966675Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.05625796318054199, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.accepted_values_stg_hr_policy_category__PTO__Overtime__Payroll__Benefits__FMLA__Expense__Performance.a0fe57a24e", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        category as value_field,\n        count(*) as n_records\n\n    from \"data\".\"main_staging\".\"stg_hr_policy\"\n    group by category\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'PTO','Overtime','Payroll','Benefits','FMLA','Expense','Performance'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-30T06:16:54.969596Z", "completed_at": "2026-10-30T06:16:54.990025Z"}, {"name": "execute", "started_at": "2026-10-30T06:16:54.992095Z", "completed_at": "2026-10-30T06:16:54.992105Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.027309179306030273, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.not_null_stg_hr_policy_category.3d65b5e3b9", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect category\nfrom \"data\".\"main_staging\".\"stg_hr_policy\"\nwhere category is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-30T06:16:54.982570Z", "completed_at": "2026-10-30T06:1