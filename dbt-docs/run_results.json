stamp,\n        date_trunc('day', event_timestamp) as event_date,\n        date_trunc('hour', event_timestamp) as event_hour\n    from base_events\n)\n\nselect * from events_with_attributes", "relation_name": "\"data\".\"main_marts\".\"events_incremental\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-02T08:24:40.230130Z", "completed_at": "2026-08-02T08:24:40.265234Z"}, {"name": "execute", "started_at": "2026-08-02T08:24:40.286420Z", "completed_at": "2026-08-02T08:24:40.286429Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.060553789138793945, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.unique_stg_arbitration_subrogation_doc_id.1245dac82b", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    doc_id as unique_field,\n    count(*) as n_records\n\nfrom \"data\".\"main_staging\".\"stg_arbitration_subrogation\"\nwhere doc_id is not null\ngroup by doc_id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-02T08:24:40.247202Z", "completed_at": "2026-08-02T08:24:40.285915Z"}, {"name": "execute", "started_at": "2026-08-02T08:24:40.287834Z", "completed_at": "2026-08-02T08:24:40.287844Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.05888223648071289, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.hr_policy_features", "compiled": true, "compiled_code": "-- HR policy features mart\nWITH base AS (\n  SELECT * FROM \"data\".\"main_staging\".\"stg_hr_policy\"\n), enriched AS (\n  SELECT\n    policy_id,\n    category,\n    raw_text,\n    CASE WHEN category = 'PTO' THEN 1.67 ELSE NULL END AS accrual_days_per_month,\n    raw_text LIKE '%overtime%' AS mentions_overtime,\n    raw_text LIKE '%bi-weekly%' AS mentions_payroll_cycle