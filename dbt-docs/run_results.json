' || cast(row_number() over (order by policy_id) as varchar) as event_id,\n        'policy_view' as event_type,\n        policy_id as related_entity_id,\n        'hr_policy' as entity_type,\n        category as event_metadata,\n        current_timestamp as event_timestamp\n    from \"data\".\"main_staging\".\"stg_hr_policy\"\n    \n    \n    -- Only process new records on incremental runs\n    where current_timestamp > (select max(event_timestamp) from \"data\".\"main_marts\".\"events_incremental\")\n    \n),\n\nevents_with_attributes as (\n    select\n        event_id,\n        event_type,\n        related_entity_id,\n        entity_type,\n        event_metadata,\n        event_timestamp,\n        date_trunc('day', event_timestamp) as event_date,\n        date_trunc('hour', event_timestamp) as event_hour\n    from base_events\n)\n\nselect * from events_with_attributes", "relation_name": "\"data\".\"main_marts\".\"events_incremental\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-10T06:22:23.152541Z", "completed_at": "2026-09-10T06:22:23.225259Z"}, {"name": "execute", "started_at": "2026-09-10T06:22:23.227389Z", "completed_at": "2026-09-10T06:22:23.227401Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.09735321998596191, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.not_null_stg_hr_policy_category.3d65b5e3b9", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect category\nfrom \"data\".\"main_staging\".\"stg_hr_policy\"\nwhere category is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-10T06:22:23.142180Z", "completed_at": "2026-09-10T06:22:23.225803Z"}, {"name": "execute", "started_at": "2026-09-10T06:22:23.228196Z", "completed_at": "2026-09-10T06:22:23.228208Z"}], "thread_id": "Thread-3 (work