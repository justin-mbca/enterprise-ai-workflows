ct * from events_with_attributes", "relation_name": "\"data\".\"main_marts\".\"events_incremental\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-18T07:50:07.885325Z", "completed_at": "2026-07-18T07:50:07.927407Z"}, {"name": "execute", "started_at": "2026-07-18T07:50:07.935575Z", "completed_at": "2026-07-18T07:50:07.935585Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.06333255767822266, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.accepted_values_stg_hr_policy_category__PTO__Overtime__Payroll__Benefits__FMLA__Expense__Performance.a0fe57a24e", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        category as value_field,\n        count(*) as n_records\n\n    from \"data\".\"main_staging\".\"stg_hr_policy\"\n    group by category\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'PTO','Overtime','Payroll','Benefits','FMLA','Expense','Performance'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-18T07:50:07.929225Z", "completed_at": "2026-07-18T07:50:07.945020Z"}, {"name": "execute", "started_at": "2026-07-18T07:50:07.953039Z", "completed_at": "2026-07-18T07:50:07.953050Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.028578519821166992, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.not_null_stg_hr_policy_category.3d65b5e3b9", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect category\nfrom \"data\".\"main_staging\".\"stg_hr_policy\"\nwhere category is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-18T07:50:07.938257Z", "completed_at": "2026-07-18T07:50: