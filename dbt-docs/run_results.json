completed_at": "2026-01-24T06:34:30.873799Z"}, {"name": "execute", "started_at": "2026-01-24T06:34:30.887654Z", "completed_at": "2026-01-24T06:34:30.887664Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.02275252342224121, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.document_index", "compiled": true, "compiled_code": "-- Document index mart combining all domains\nWITH hr AS (\n  SELECT policy_id AS id, category AS domain, raw_text AS text FROM \"data\".\"main_staging\".\"stg_hr_policy\"\n), arb AS (\n  SELECT doc_id AS id, category AS domain, raw_text AS text FROM \"data\".\"main_staging\".\"stg_arbitration_subrogation\"\n), ml AS (\n  SELECT concept_id AS id, topic AS domain, raw_text AS text FROM \"data\".\"main_staging\".\"stg_ml_concepts\"\n), unioned AS (\n  SELECT * FROM hr\n  UNION ALL\n  SELECT * FROM arb\n  UNION ALL\n  SELECT * FROM ml\n)\nSELECT * FROM unioned", "relation_name": "\"data\".\"main_marts\".\"document_index\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-01-24T06:34:30.874240Z", "completed_at": "2026-01-24T06:34:30.889156Z"}, {"name": "execute", "started_at": "2026-01-24T06:34:30.891489Z", "completed_at": "2026-01-24T06:34:30.891498Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.024422645568847656, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.events_incremental", "compiled": true, "compiled_code": "\n\n/*\n    Incremental events model demonstrating scalability pattern.\n    \n    In a production setting this would capture:\n    - User interactions (RAG queries, dashboard page views)\n    - System events (pipeline runs, validation results)\n    - Audit trail for governance\n    \n    For portfolio purposes, this is a synthetic example showing:\n    - is_incremental() logic\n    - Unique key constraint\n    - Timestamp-based filtering\n    - Schema evolution handling\n*/\n\nwith base_events as (\n    select\n        -- Synthetic event generation for demo purposes\n        'evt_' || cast(row_number() over (order by policy_id) as varchar) as event_id,\n        'policy_view' as event_type,\n        policy_id as related_entity_id,\n        'hr_policy' as entity_type,\n        category as event_metadata,\n        current_timestamp as event_timestamp\n    from \"data\".\"main_staging\".\"stg_hr_policy\"\n    \n    \n    -- Only process new records on incremental runs\n    where current_timestamp > (select max(event_timestamp) from \"data\".\"main_marts\".\"events_incremental\")\n    \n),\n\nevents_with_attributes as (\n    select\n        event_id,\n        event_type,\n        related_entity_id,\n        entity_type,\n        event_metadata,\n        event_timestamp,\n        date_trunc('day', event_timestamp) as event_date,\n        date_trunc('hour', event_timestamp) as event_hour\n    from base_events\n)\n\nselect * from events_with_attributes", "relation_name": "\"data\".\"main_marts\".\"events_incremental\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-01-24T06:34:30.884990Z", "completed_at": "2026-01-24T06:34:30.890976Z"}, {"name": "execute", "started_at": "2026-01-24T06:34:30.902962Z", "completed_at": "2026-01-24T06:34:30.902974Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.031774044036865234, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.hr_policy_features", "compiled": true, "compiled_code": "-- HR policy features mart\nWITH base AS (\n  SELECT * FROM \"data\".\"main_staging\".\"stg_hr_policy\"\n), enriched AS (\n  SELECT\n    policy_id,\n    category,\n    raw_text,\n    CASE WHEN category = 'PTO' THEN 1.67 ELSE NULL END AS accrual_days_per_month,\n    raw_text LIKE '%overtime%' AS mentions_overtime,\n    raw_text LIKE '%bi-weekly%' AS mentions_payroll_cycle\n  FROM base\n)\nSELECT * FROM enriched", "relation_name": "\"data\".\"main_marts\".\"hr_policy_features\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-01-24T06:34:30.892723Z", "completed_at": "2026-01-24T06:34:30.915949Z"}, {"name": "execute", "started_at": "2026-01-24T06:34:30.920771Z", "completed_at": "2026-01-24T06:34:30.920786Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.03234744071960449, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.accepted_values_stg_hr_policy_category__PTO__Overtime__Payroll__Benefits__FMLA__Expense__Performance.a0fe57a24e", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        category as value_field,\n        count(*) as n_records\n\n    from \"data\".\"main_staging\".\"stg_hr_policy\"\n    group by category\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'PTO','Overtime','Payroll','Benefits','FMLA','Expense','Performance'\n)\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-01-24T06:34:30.910781Z", "completed_at": "2026-01-24T06:34:30.922170Z"}, {"name": "execute", "started_at": "2026-01-24T06:34:30.931330Z", "completed_at": "2026-01-24T06:34:30.931341Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.03924393653869629, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.not_null_stg_arbitration_subrogation_category.45450e1726", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect category\nfrom \"data\".\"main_staging\".\"stg_arbitration_subrogation\"\nwhere category is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-01-24T06:34:30.922670Z", "completed_at": "2026-01-24T06:34:30.934254Z"}, {"name": "execute", "started_at": "2026-01-24T06:3