024074316024780273, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.document_index", "compiled": true, "compiled_code": "-- Document index mart combining all domains\nWITH hr AS (\n  SELECT policy_id AS id, category AS domain, raw_text AS text FROM \"data\".\"main_staging\".\"stg_hr_policy\"\n), arb AS (\n  SELECT doc_id AS id, category AS domain, raw_text AS text FROM \"data\".\"main_staging\".\"stg_arbitration_subrogation\"\n), ml AS (\n  SELECT concept_id AS id, topic AS domain, raw_text AS text FROM \"data\".\"main_staging\".\"stg_ml_concepts\"\n), unioned AS (\n  SELECT * FROM hr\n  UNION ALL\n  SELECT * FROM arb\n  UNION ALL\n  SELECT * FROM ml\n)\nSELECT * FROM unioned", "relation_name": "\"data\".\"main_marts\".\"document_index\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-06-12T10:14:16.567014Z", "completed_at": "2026-06-12T10:14:16.579734Z"}, {"name": "execute", "started_at": "2026-06-12T10:14:16.582147Z", "completed_at": "2026-06-12T10:14:16.582156Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.02434539794921875, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.events_incremental", "compiled": true, "compiled_code": "\n\n/*\n    Incremental events model demonstrating scalability pattern.\n    \n    In a production setting this would capture:\n    - User interactions (RAG queries, dashboard page views)\n    - System events (pipeline runs, validation results)\n    - Audit trail for governance\n    \n    For portfolio purposes, this is a synthetic example showing:\n    - is_incremental() logic\n    - Unique key constraint\n    - Timestamp-based filtering\n    - Schema evolution handling\n*/\n\nwith base_events as (\n    select\n        -- Synthetic event generation for demo purposes\n        'evt_' || cast(row_number() over (order by policy_id) as varchar) as event_id,\n       