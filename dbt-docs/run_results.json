iled_code": "\n    \n    \n\n\n\nselect category\nfrom \"data\".\"main_staging\".\"stg_arbitration_subrogation\"\nwhere category is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-28T06:17:05.625410Z", "completed_at": "2026-10-28T06:17:05.636918Z"}, {"name": "execute", "started_at": "2026-10-28T06:17:05.649343Z", "completed_at": "2026-10-28T06:17:05.649356Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.02912759780883789, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.unique_stg_arbitration_subrogation_doc_id.1245dac82b", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    doc_id as unique_field,\n    count(*) as n_records\n\nfrom \"data\".\"main_staging\".\"stg_arbitration_subrogation\"\nwhere doc_id is not null\ngroup by doc_id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-28T06:17:05.639790Z", "completed_at": "2026-10-28T06:17:05.650747Z"}, {"name": "execute", "started_at": "2026-10-28T06:17:05.652945Z", "completed_at": "2026-10-28T06:17:05.652959Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.019097328186035156, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.events_incremental", "compiled": true, "compiled_code": "\n\n/*\n    Incremental events model demonstrating scalability pattern.\n    \n    In a production setting this would capture:\n    - User interactions (RAG queries, dashboard page views)\n    - System events (pipeline runs, validation results)\n    - Audit trail for governance\n    \n    For portfolio purposes, this is a synthetic example showing:\n    - is_incremental() logic\n    - Unique key constraint\n    - Timestamp-based filtering\n    - Schema evolution handling\n*/\n\nwith base_events as (\n    select\n        -- Synthetic event generation for demo purposes\n        'evt_' || cast(row_number() over (order by policy_id) as varchar) as event_id,\n        'policy_view' as event_type,\n        policy_id as related_entity_id,\n        'hr_policy' as entity_type,\n        category as event_metadata,\n        current_timestamp as event_timestamp\n    from \"data\".\"main_staging\".\"stg_hr_policy\"\n    \n    \n    -- Only process new records on incremental runs\n    where current_timestamp > (select max(event_timestamp) from \"data\".\"main_marts\".\"events_incremental\")\n    \n),\n\nevents_with_attributes as (\n    select\n        event_id,\n        event_type,\n        related_entity_id,\n        entity_type,\n        event_metadata,\n        event_timestamp,\n        date_trunc('day', event_timestamp) as event_date,\n        date_trunc('hour', event_timestamp) as event_hour\n    from base_events\n)\n\nselect * from events_with_attributes", "relation_name": "\"data\".\"main_marts\".\"events_incremental\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-28T06:17:05.647523Z", "completed_at": "2026-10-28T06:17:05.651879Z"}, {"name": "execute", "started_at": "2026-10-28T06:17:05.654320Z", "completed_at": "2026-10-28T06:17:05.654332Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.019881248474121094, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.hr_policy_features", "compiled": true, "compiled_code": "-- HR policy features mart\nWITH base AS (\n  SELECT * FROM \"data\".\"main_staging\".\"stg_hr_policy\"\n), enriched AS (\n  SELECT\n    policy_id,\n    category,\n    raw_text,\n    CASE WHEN category = 'PTO' THEN 1.67 ELSE NULL END AS accrual_days_per_month,\n    raw_text LIKE '%overtime%' AS mentions_overtime,\n    raw_text LIKE '%bi-weekly%' AS mentions_payroll_cycle\n  FROM base\n)\nSELECT * FROM enriched", "relation_name": "\"data\".\"main_marts\".\"hr_policy_features\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-28T06:17:05.637462Z", "completed_at": "2026-10-28T06:17:05.652394Z"}, {"name": "execute", "started_at": "2026-10-28T06:17:05.655103Z", "completed_at": "2026-10-28T06:17:05.655112Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.030466556549072266, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.document_index", "compiled": true, "compiled_code": "-- Document index mart combining all domains\nWITH hr AS (\n  SELECT policy_id AS id, category AS domain, raw_text AS text FROM \"data\".\"main_staging\".\"stg_hr_policy\"\n), arb AS (\n  SELECT doc_id AS id, category AS domain, raw_text AS text FROM \"data\".\"main_staging\".\"stg_arbitration_subrogation\"\n), ml AS (\n  SELECT concept_id AS id, topic AS domain, raw_text AS text FROM \"data\".\"main_staging\".\"stg_ml_concepts\"\n), unioned AS (\n  SELECT * FROM hr\n  UNION ALL\n  SELECT * FROM arb\n  UNION ALL\n  SELECT * FROM ml\n)\nSELECT * FROM unioned", "relation_name": "\"data\".\"main_marts\".\"document_index\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-28T06:17:05.658984Z", "completed_at": "2026-10-28T06:17:05.717257Z"}, {"name": "execute", "started_at": "2026-10-28T06:17:05.717841Z", "completed_at": "2026-10-28T06:17:05.717851Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.0642099380493164, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.accepted_values_stg_hr_policy_category__PTO__Overtime__Payroll__Benefits__FMLA__Expense__Performance.a0fe57a24e", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        category as value_field