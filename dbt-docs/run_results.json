n handling\n*/\n\nwith base_events as (\n    select\n        -- Synthetic event generation for demo purposes\n        'evt_' || cast(row_number() over (order by policy_id) as varchar) as event_id,\n        'policy_view' as event_type,\n        policy_id as related_entity_id,\n        'hr_policy' as entity_type,\n        category as event_metadata,\n        current_timestamp as event_timestamp\n    from \"data\".\"main_staging\".\"stg_hr_policy\"\n    \n    \n    -- Only process new records on incremental runs\n    where current_timestamp > (select max(event_timestamp) from \"data\".\"main_marts\".\"events_incremental\")\n    \n),\n\nevents_with_attributes as (\n    select\n        event_id,\n        event_type,\n        related_entity_id,\n        entity_type,\n        event_metadata,\n        event_timestamp,\n        date_trunc('day', event_timestamp) as event_date,\n        date_trunc('hour', event_timestamp) as event_hour\n    from base_events\n)\n\nselect * from events_with_attributes", "relation_name": "\"data\".\"main_marts\".\"events_incremental\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-04T06:14:30.742958Z", "completed_at": "2026-11-04T06:14:30.778547Z"}, {"name": "execute", "started_at": "2026-11-04T06:14:30.780371Z", "completed_at": "2026-11-04T06:14:30.780380Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.046561479568481445, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.hr_policy_features", "compiled": true, "compiled_code": "-- HR policy features mart\nWITH base AS (\n  SELECT * FROM \"data\".\"main_staging\".\"stg_hr_policy\"\n), enriched AS (\n  SELECT\n    policy_id,\n    category,\n    raw_text,\n    CASE WHEN category = 'PTO' THEN 1.67 ELSE NULL END AS accrual_days_per_month,\n    raw_text LIKE '%overtime%' AS mentions_overtime,\n    raw_text LIKE '%bi-weekly%' AS mentions_payroll_cycle\n  F