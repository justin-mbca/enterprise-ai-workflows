olution handling\n*/\n\nwith base_events as (\n    select\n        -- Synthetic event generation for demo purposes\n        'evt_' || cast(row_number() over (order by policy_id) as varchar) as event_id,\n        'policy_view' as event_type,\n        policy_id as related_entity_id,\n        'hr_policy' as entity_type,\n        category as event_metadata,\n        current_timestamp as event_timestamp\n    from \"data\".\"main_staging\".\"stg_hr_policy\"\n    \n    \n    -- Only process new records on incremental runs\n    where current_timestamp > (select max(event_timestamp) from \"data\".\"main_marts\".\"events_incremental\")\n    \n),\n\nevents_with_attributes as (\n    select\n        event_id,\n        event_type,\n        related_entity_id,\n        entity_type,\n        event_metadata,\n        event_timestamp,\n        date_trunc('day', event_timestamp) as event_date,\n        date_trunc('hour', event_timestamp) as event_hour\n    from base_events\n)\n\nselect * from events_with_attributes", "relation_name": "\"data\".\"main_marts\".\"events_incremental\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-22T06:10:35.846288Z", "completed_at": "2026-08-22T06:10:35.877429Z"}, {"name": "execute", "started_at": "2026-08-22T06:10:35.879467Z", "completed_at": "2026-08-22T06:10:35.879473Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.04212665557861328, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.hr_policy_features", "compiled": true, "compiled_code": "-- HR policy features mart\nWITH base AS (\n  SELECT * FROM \"data\".\"main_staging\".\"stg_hr_policy\"\n), enriched AS (\n  SELECT\n    policy_id,\n    category,\n    raw_text,\n    CASE WHEN category = 'PTO' THEN 1.67 ELSE NULL END AS accrual_days_per_month,\n    raw_text LIKE '%overtime%' AS mentions_overtime,\n    raw_text LIKE '%bi-weekly%' AS mentions_payroll_cycle\n  FROM base\n)\nSELECT * FROM enriched", "relation_name": "\"data\".\"main_marts\".\"hr_policy_features\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-22T06:10:35.847831Z", "completed_at": "2026-08-22T06:10:35.878650Z"}, {"name": "execute", "started_at": "2026-08-22T06:10:35.880507Z", "completed_at": "2026-08-22T06:10:35.880514Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.04274487495422363, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.accepted_values_stg_hr_policy_category__PTO__Overtime__Payroll__Benefits__FMLA__Expense__Performance.a0fe57a24e", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        category as value_field,\n        count(*) as n_records\n\n    from \"data\".\"main_staging\".\"stg_hr_policy\"\n    group by category\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'PTO','Overtime','Payroll','Benefits','FMLA','Expense','Performance'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-22T06:10:35.882858Z", "completed_at": "2026-08-22T06:10:35.895551Z"}, {"name": "execute", "started_at": "2026-08-22T06:10:35.906007Z", "completed_at": "2026-08-22T06:10:35.906019Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.027103900909423828, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.not_null_stg_hr_policy_category.3d65b5e3b9", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect category\nfrom \"data\".\"main_staging\".\"stg_hr_policy\"\nwhere category is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-22T06:10:35.889972Z", "completed_at": "2026-08-2