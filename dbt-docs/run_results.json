ct * from events_with_attributes", "relation_name": "\"data\".\"main_marts\".\"events_incremental\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-22T08:29:39.319856Z", "completed_at": "2026-07-22T08:29:39.358919Z"}, {"name": "execute", "started_at": "2026-07-22T08:29:39.361458Z", "completed_at": "2026-07-22T08:29:39.361471Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.061988115310668945, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.accepted_values_stg_hr_policy_category__PTO__Overtime__Payroll__Benefits__FMLA__Expense__Performance.a0fe57a24e", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        category as value_field,\n        count(*) as n_records\n\n    from \"data\".\"main_staging\".\"stg_hr_policy\"\n    group by category\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'PTO','Overtime','Payroll','Benefits','FMLA','Expense','Performance'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-22T08:29:39.365124Z", "completed_at": "2026-07-22T08:29:39.379893Z"}, {"name": "execute", "started_at": "2026-07-22T08:29:39.393155Z", "completed_at": "2026-07-22T08:29:39.393168Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.03307628631591797, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.not_null_stg_hr_policy_category.3d65b5e3b9", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect category\nfrom \"data\".\"main_staging\".\"stg_hr_policy\"\nwhere category is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-22T08:29:39.373082Z", "completed_at": "2026-07-22T08:29: