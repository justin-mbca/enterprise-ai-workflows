_policy_features\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-21T06:13:08.632218Z", "completed_at": "2026-11-21T06:13:08.657646Z"}, {"name": "execute", "started_at": "2026-11-21T06:13:08.658816Z", "completed_at": "2026-11-21T06:13:08.658820Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.03342580795288086, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.events_incremental", "compiled": true, "compiled_code": "\n\n/*\n    Incremental events model demonstrating scalability pattern.\n    \n    In a production setting this would capture:\n    - User interactions (RAG queries, dashboard page views)\n    - System events (pipeline runs, validation results)\n    - Audit trail for governance\n    \n    For portfolio purposes, this is a synthetic example showing:\n    - is_incremental() logic\n    - Unique key constraint\n    - Timestamp-based filtering\n    - Schema evolution handling\n*/\n\nwith base_events as (\n    select\n        -- Synthetic event generation for demo purposes\n        'evt_' || cast(row_number() over (order by policy_id) as varchar) as event_id,\n        'policy_view' as event_type,\n        policy_id as related_entity_id,\n        'hr_policy' as entity_type,\n        category as event_metadata,\n        current_timestamp as event_timestamp\n    from \"data\".\"main_staging\".\"stg_hr_policy\"\n    \n    \n    -- Only process new records on incremental runs\n    where current_timestamp > (select max(event_timestamp) from \"data\".\"main_marts\".\"events_incremental\")\n    \n),\n\nevents_with_attributes as (\n    select\n        event_id,\n        event_type,\n        related_entity_id,\n        entity_type,\n        event_metadata,\n        event_timestamp,\n        date_trunc('day', event_timestamp) as event_date,\n        date_trunc('hour', event_timestamp) as event_hour\n    from base_events\n)\n\