cremental\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-04-21T07:52:09.768832Z", "completed_at": "2026-04-21T07:52:09.787543Z"}, {"name": "execute", "started_at": "2026-04-21T07:52:09.790097Z", "completed_at": "2026-04-21T07:52:09.790109Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.035706281661987305, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.hr_policy_features", "compiled": true, "compiled_code": "-- HR policy features mart\nWITH base AS (\n  SELECT * FROM \"data\".\"main_staging\".\"stg_hr_policy\"\n), enriched AS (\n  SELECT\n    policy_id,\n    category,\n    raw_text,\n    CASE WHEN category = 'PTO' THEN 1.67 ELSE NULL END AS accrual_days_per_month,\n    raw_text LIKE '%overtime%' AS mentions_overtime,\n    raw_text LIKE '%bi-weekly%' AS mentions_payroll_cycle\n  FROM base\n)\nSELECT * FROM enriched", "relation_name": "\"data\".\"main_marts\".\"hr_policy_features\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-04-21T07:52:09.771455Z", "completed_at": "2026-04-21T07:52:09.788097Z"}, {"name": "execute", "started_at": "2026-04-21T07:52:09.790866Z", "completed_at": "2026-04-21T07:52:09.790875Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.03593564033508301, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.accepted_values_stg_hr_policy_category__PTO__Overtime__Payroll__Benefits__FMLA__Expense__Performance.a0fe57a24e", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        category as value_field,\n        count(*) as n_records\n\n    from \"data\".\"main_staging\".\"stg_hr_policy\"\n    group by category\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'PTO','Overtime','Payroll','Benefits','FMLA','Expense','Performance'\n)\n\n\n", "relation_name": null, "ba