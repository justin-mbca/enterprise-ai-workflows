", "started_at": "2026-05-06T08:27:41.896339Z", "completed_at": "2026-05-06T08:27:41.896351Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.029793977737426758, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.events_incremental", "compiled": true, "compiled_code": "\n\n/*\n    Incremental events model demonstrating scalability pattern.\n    \n    In a production setting this would capture:\n    - User interactions (RAG queries, dashboard page views)\n    - System events (pipeline runs, validation results)\n    - Audit trail for governance\n    \n    For portfolio purposes, this is a synthetic example showing:\n    - is_incremental() logic\n    - Unique key constraint\n    - Timestamp-based filtering\n    - Schema evolution handling\n*/\n\nwith base_events as (\n    select\n        -- Synthetic event generation for demo purposes\n        'evt_' || cast(row_number() over (order by policy_id) as varchar) as event_id,\n        'policy_view' as event_type,\n        policy_id as related_entity_id,\n        'hr_policy' as entity_type,\n        category as event_metadata,\n        current_timestamp as event_timestamp\n    from \"data\".\"main_staging\".\"stg_hr_policy\"\n    \n    \n    -- Only process new records on incremental runs\n    where current_timestamp > (select max(event_timestamp) from \"data\".\"main_marts\".\"events_incremental\")\n    \n),\n\nevents_with_attributes as (\n    select\n        event_id,\n        event_type,\n        related_entity_id,\n        entity_type,\n        event_metadata,\n        event_timestamp,\n        date_trunc('day', event_timestamp) as event_date,\n        date_trunc('hour', event_timestamp) as event_hour\n    from base_events\n)\n\nselect * from events_with_attributes", "relation_name": "\"data\".\"main_marts\".\"events_incremental\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-06T08:27:41.883835Z", "completed_at": "2026-05-06T08:27:41.903231Z"}, {"name": "execute", "started_at": "2026-05-06T08:27:41.905185Z", "completed_at": "2026-05-06T08:27:41.905197Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.03531932830810547, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.accepted_values_stg_hr_policy_category__PTO__Overtime__Payroll__Benefits__FMLA__Expense__Performance.a0fe57a24e", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        category as value_field,\n        count(*) as n_records\n\n    from \"data\".\"main_staging\".\"stg_hr_policy\"\n    group by category\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'PTO','Overtime','Payroll','Benefits','FMLA','Expense','Performance'\n)\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-06T08:27:41.897175Z", "completed_at": "2026-05-06T08:27:41.906446Z"}, {"name": "execute", "started_at": "2026-05-06T08:27:41.908430Z", "completed_at": "2026-05-06T08:27:41.908442Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.02601933479309082, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.not_null_stg_hr_policy_category.3d65b5e3b9", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect category\nfrom \"data\".\"main_staging\".\"stg_hr_policy\"\nwhere category is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-06T08:27:41.909167Z", "completed_at": "2026-05-06T08:27:41.918570Z"}, {"name": "execute", "started_at": "2026-05-06T08:27:41.924018Z", "completed_at": "2026-05-06T08:27:41.924030Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.01953268051147461, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.