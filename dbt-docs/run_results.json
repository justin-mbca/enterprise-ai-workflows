lts": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-01-30T06:53:22.208656Z", "completed_at": "2026-01-30T06:53:22.219520Z"}, {"name": "execute", "started_at": "2026-01-30T06:53:22.222181Z", "completed_at": "2026-01-30T06:53:22.222192Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.024547576904296875, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.stg_hr_policy", "compiled": true, "compiled_code": "-- Staging model for HR policy seed\nWITH source AS (\n  SELECT * FROM \"data\".\"main\".\"hr_policy\"\n)\nSELECT\n  policy_id,\n  category,\n  text AS raw_text,\n  LENGTH(text) AS text_length,\n  CURRENT_TIMESTAMP AS ingested_at\nFROM source", "relation_name": "\"data\".\"main_staging\".\"stg_hr_policy\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-01-30T06:53:22.229262Z", "completed_at": "2026-01-30T06:53:22.324919Z"}, {"name": "execute", "started_at": "2026-01-30T06:53:22.328055Z", "completed_at": "2026-01-30T06:53:22.328077Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.10325884819030762, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.arbitration_timelines", "compiled": true, "compiled_code": "-- Arbitration timelines mart\nWITH base AS (\n  SELECT * FROM \"data\".\"main_staging\".\"stg_arbitration_subrogation\"\n), extracted AS (\n  SELECT\n    doc_id,\n    category,\n    raw_text,\n    CASE WHEN raw_text LIKE '%90 days%' THEN 90 END AS hearing_target_days,\n    CASE WHEN raw_text LIKE '%180 days%' THEN 180 END AS appeal_window_days,\n    CASE WHEN raw_text LIKE '%one year%' THEN 365 END AS filing_deadline_days\n  FROM base\n)\nSELECT * FROM extracted", "relation_name": "\"data\".\"main_marts\".\"arbitration_timelines\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-01-30T06:53:22.232905Z", "completed_at": "2026-01-30T06:53:22.326074Z"}, {"name": "execute", "started_at": "2026-01-30T06:53:22.329193Z", "completed_at": "2026-01-30T06:53:22.329204Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.10319733619689941, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.document_index", "compiled": true, "compiled_code": "-- Document index mart combining all domains\nWITH hr AS (\n  SELECT policy_id AS id, category AS domain, raw_text AS text FROM \"data\".\"main_staging\".\"stg_hr_policy\"\n), arb AS (\n  SELECT doc_id AS id, category AS domain, raw_text AS text FROM \"data\".\"main_staging\".\"stg_arbitration_subrogation\"\n), ml AS (\n  SELECT concept_id AS id, topic AS domain, raw_text AS text FROM \"data\".\"main_staging\".\"stg_ml_concepts\"\n), unioned AS (\n  SELECT * FROM hr\n  UNION ALL\n  SELECT * FROM arb\n  UNION ALL\n  SELECT * FROM ml\n)\nSELECT * FROM unioned", "relation_name": "\"data\".\"main_marts\".\"document_index\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-01-30T06:53:22.236525Z", "completed_at": "2026-01-30T06:53:22.326864Z"}, {"name": "execute", "started_at": "2026-01-30T06:53:22.329982Z", "completed_at": "2026-01-30T06:53:22.329993Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.10231709480285645, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.events_incremental", "compiled": true, "compiled_code": "\n\n/*\n    Incremental events model demonstrating scalability pattern.\n    \n    In a production setting this would capture:\n    - User interactions (RAG queries, dashboard page views)\n    - System events (pipeline runs, validation results)\n    - Audit trail for governance\n    \n    For portfolio purposes, this is a synthetic example showing:\n    - is_incremental() logic\n    - Unique key constraint\n    - Timestamp-based filtering\n    - Schema evolution handling\n*/\n\nwith base_events as (\n    select\n        -- Synthetic event generation for demo purposes\n        'evt_' || cast(row_number() over (order by policy_id) as varchar) as event_id,\n        'policy_view' as event_type,\n        policy_id as related_entity_id,\n        'hr_policy' as entity_type,\n        category as event_metadata,\n        current_timestamp as event_timestamp\n    from \"data\".\"main_staging\".\"stg_hr_policy\"\n    \n    \n    -- Only process new records on incremental runs\n    where current_timestamp > (select max(event_timestamp) from \"data\".\"main_marts\".\"events_incremental\")\n    \n),\n\nevents_with_attributes as (\n    select\n        event_id,\n        event_type,\n        related_entity_id,\n        entity_type,\n        event_metadata,\n        event_timestamp,\n        date_trunc('day', event_timestamp) as event_date,\n        date_trunc('hour', event_timestamp) as event_hour\n    from base_events\n)\n\nselect * from events_with_attributes", "relation_name": "\"data\".\"main_marts\".\"events_incremental\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-01-30T06:53:22.247119Z", "completed_at": "2026-01-30T06:53:22.327495Z"}, {"name": "execute", "started_at": "2026-01-30T06:53:22.330987Z", "completed_at": "2026-01-30T06:53:22.330996Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.1023092269897461, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.hr_policy_features", "compiled": true, "compiled_code": "-- HR policy features mart\nWITH base AS (\n  SELECT * FROM \"data\".\"main_staging\".\"stg_hr_policy\"\n), enriched AS (\n  SELECT\n    policy_id,\n    category,\n    raw_text,\n    CASE WHEN category = 'PTO' THEN 1.67 ELSE NULL END AS accrual_days_per_month,\n    raw_text LIKE '%overtime%' AS mentions_overtime,\n    raw_text LIKE '%bi-weekly%' AS mentions_payroll_cycle\n  FROM base\n)\nSELECT * FROM enriched", "relation_name": "\"data\".\"main_marts\".\"hr_policy_features\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-01-30T06:53:22.349626Z", "completed_at": "2026-01-30T06:53:22.422215Z"}, {"name": "execute", "started_at": "2026-01-30T06:53:22.425572Z", "completed_at": "2026-01-30T06:53:22.425594Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.09009575843811035, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.not_null_stg_arbitration_subrogation_category.45450e1726", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect category\nfrom \"data\".\"main_staging\".\"stg_arbitration_subrogation\"\nwhere category is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-01-30T06:53:22.363286Z", "completed_at": "2026-01-30T06:53:22.423539Z"}, {"name": "execute", "started_at": "2026-01-30T06:53:22.426758Z", "completed_at": "2026-01-30T06:53:22.426768Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.09062600135803223, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.not_null_stg_arbitration_subrogation_doc_id.3dbb5b241d", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect doc_id\nfrom \"data\".\"main_staging\".\"stg_arbitration_subrogation\"\nwhere doc_id is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-01-30T06:53:22.367594Z", "completed_at": "2026-01-30T06:53:22.424253Z"}, {"name": "execute", "started_at": "2026-01-30T06:53:22.427510Z", "completed_at": "2026-01-30T06:53:22.427520Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.09085464477539062, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.not_null_stg_arbitration_subr