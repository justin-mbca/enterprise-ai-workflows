t_' || cast(row_number() over (order by policy_id) as varchar) as event_id,\n        'policy_view' as event_type,\n        policy_id as related_entity_id,\n        'hr_policy' as entity_type,\n        category as event_metadata,\n        current_timestamp as event_timestamp\n    from \"data\".\"main_staging\".\"stg_hr_policy\"\n    \n    \n    -- Only process new records on incremental runs\n    where current_timestamp > (select max(event_timestamp) from \"data\".\"main_marts\".\"events_incremental\")\n    \n),\n\nevents_with_attributes as (\n    select\n        event_id,\n        event_type,\n        related_entity_id,\n        entity_type,\n        event_metadata,\n        event_timestamp,\n        date_trunc('day', event_timestamp) as event_date,\n        date_trunc('hour', event_timestamp) as event_hour\n    from base_events\n)\n\nselect * from events_with_attributes", "relation_name": "\"data\".\"main_marts\".\"events_incremental\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-07-21T08:28:55.756773Z", "completed_at": "2026-07-21T08:28:55.791091Z"}, {"name": "execute", "started_at": "2026-07-21T08:28:55.810784Z", "completed_at": "2026-07-21T08:28:55.810803Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.0588071346282959, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.arbitration_timelines", "compiled": true, "compiled_code": "-- Arbitration timelines mart\nWITH base AS (\n  SELECT * FROM \"data\".\"main_staging\".\"stg_arbitration_subrogation\"\n), extracted AS (\n  SELECT\n    doc_id,\n    category,\n    raw_text,\n    CASE WHEN raw_text LIKE '%90 days%' THEN 90 END AS hearing_target_days,\n    CASE WHEN raw_text LIKE '%180 days%' THEN 180 END AS appeal_window_days,\n    CASE WHEN raw_text LIKE '%one year%' THEN 365 END AS filing_deadline_days\n  FROM base\n)\nSELECT * FROM extracted", "relation_name": "\"data\".\