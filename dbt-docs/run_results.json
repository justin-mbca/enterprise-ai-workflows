lect * from events_with_attributes", "relation_name": "\"data\".\"main_marts\".\"events_incremental\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-08T06:13:28.786025Z", "completed_at": "2026-11-08T06:13:28.827607Z"}, {"name": "execute", "started_at": "2026-11-08T06:13:28.830235Z", "completed_at": "2026-11-08T06:13:28.830246Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.05647540092468262, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.accepted_values_stg_hr_policy_category__PTO__Overtime__Payroll__Benefits__FMLA__Expense__Performance.a0fe57a24e", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        category as value_field,\n        count(*) as n_records\n\n    from \"data\".\"main_staging\".\"stg_hr_policy\"\n    group by category\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'PTO','Overtime','Payroll','Benefits','FMLA','Expense','Performance'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-08T06:13:28.833585Z", "completed_at": "2026-11-08T06:13:28.854916Z"}, {"name": "execute", "started_at": "2026-11-08T06:13:28.862786Z", "completed_at": "2026-11-08T06:13:28.862797Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.033945560455322266, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.not_null_stg_hr_policy_category.3d65b5e3b9", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect category\nfrom \"data\".\"main_staging\".\"stg_hr_policy\"\nwhere category is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-08T06:13:28.840271Z", "completed_at": "2026-11-08T06:1