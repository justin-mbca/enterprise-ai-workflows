\".\"main_marts\".\"events_incremental\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-12T06:15:03.128319Z", "completed_at": "2026-11-12T06:15:03.147615Z"}, {"name": "execute", "started_at": "2026-11-12T06:15:03.174563Z", "completed_at": "2026-11-12T06:15:03.174577Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.05963420867919922, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.hr_policy_features", "compiled": true, "compiled_code": "-- HR policy features mart\nWITH base AS (\n  SELECT * FROM \"data\".\"main_staging\".\"stg_hr_policy\"\n), enriched AS (\n  SELECT\n    policy_id,\n    category,\n    raw_text,\n    CASE WHEN category = 'PTO' THEN 1.67 ELSE NULL END AS accrual_days_per_month,\n    raw_text LIKE '%overtime%' AS mentions_overtime,\n    raw_text LIKE '%bi-weekly%' AS mentions_payroll_cycle\n  FROM base\n)\nSELECT * FROM enriched", "relation_name": "\"data\".\"main_marts\".\"hr_policy_features\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-12T06:15:03.132280Z", "completed_at": "2026-11-12T06:15:03.179013Z"}, {"name": "execute", "started_at": "2026-11-12T06:15:03.181135Z", "completed_at": "2026-11-12T06:15:03.181145Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.0535123348236084, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.accepted_values_stg_hr_policy_category__PTO__Overtime__Payroll__Benefits__FMLA__Expense__Performance.a0fe57a24e", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        category as value_field,\n        count(*) as n_records\n\n    from \"data\".\"main_staging\".\"stg_hr_policy\"\n    group by category\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'PTO','Overtime','Payroll',