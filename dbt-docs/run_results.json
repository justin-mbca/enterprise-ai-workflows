ributes", "relation_name": "\"data\".\"main_marts\".\"events_incremental\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-03-31T07:16:21.284658Z", "completed_at": "2026-03-31T07:16:21.303375Z"}, {"name": "execute", "started_at": "2026-03-31T07:16:21.316201Z", "completed_at": "2026-03-31T07:16:21.316214Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.03587484359741211, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_ai_data_platform.unique_stg_arbitration_subrogation_doc_id.1245dac82b", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    doc_id as unique_field,\n    count(*) as n_records\n\nfrom \"data\".\"main_staging\".\"stg_arbitration_subrogation\"\nwhere doc_id is not null\ngroup by doc_id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-03-31T07:16:21.300370Z", "completed_at": "2026-03-31T07:16:21.315699Z"}, {"name": "execute", "started_at": "2026-03-31T07:16:21.317840Z", "completed_at": "2026-03-31T07:16:21.317849Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.03430318832397461, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.enterprise_ai_data_platform.hr_policy_features", "compiled": true, "compiled_code": "-- HR policy features mart\nWITH base AS (\n  SELECT * FROM \"data\".\"main_staging\".\"stg_hr_policy\"\n), enriched AS (\n  SELECT\n    policy_id,\n    category,\n    raw_text,\n    CASE WHEN category = 'PTO' THEN 1.67 ELSE NULL END AS accrual_days_per_month,\n    raw_text LIKE '%overtime%' AS mentions_overtime,\n    raw_text LIKE '%bi-weekly%' AS mentions_payroll_cycle\n  FROM base\n)\nSELECT * FROM enriched", "relation_name": "\"data\".\"main_marts\".\"hr_policy_features\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-03-31T07:16:21.303883Z", "co